# Copiez ce fichier en .env pour un test en local (ne jamais commiter le .env réel)

# Port d'écoute (Render fournit automatiquement PORT ; 10000 en repli local)
PORT=10000

# Identifiants API FeexPay (tableau de bord FeexPay) :
#  - FEEXPAY_API_KEY : clé API (fp_live_... en production, test_... en mode
#    sandbox), menu « Développeurs » — envoyée en Authorization: Bearer.
#  - FEEXPAY_SHOP_ID : identifiant de boutique, menu « Boutiques » — requis
#    dans le corps de CHAQUE requête Payin/Payout.
#    ⚠️ Ne JAMAIS exposer FEEXPAY_API_KEY côté client / dans un dépôt public.
FEEXPAY_BASE_URL=https://api-v2.feexpay.me/api
FEEXPAY_API_KEY=fp_live_votre_cle_api
FEEXPAY_SHOP_ID=votre_id_boutique

# URL publique de ce service. Utilisée pour :
#  - construire les return_url / cancel_url envoyées à FeexPay pour les
#    opérateurs à redirection (Orange, Wave, Moov Côte d'Ivoire...) ;
#  - afficher dans les logs où configurer l'URL de webhook (à renseigner
#    manuellement dans le dashboard FeexPay, menu Webhook — FeexPay
#    n'accepte pas de callback_url par requête).
# SUR RENDER, LAISSEZ CETTE LIGNE VIDE OU SUPPRIMEZ-LA : Render fournit
# automatiquement RENDER_EXTERNAL_URL, l'app la détecte toute seule. Ne
# renseignez PUBLIC_BASE_URL que pour forcer une valeur différente (autre
# hébergeur, domaine personnalisé, test en local — mais FeexPay ne pourra
# alors pas atteindre votre webhook tant que ce service n'est pas exposé
# publiquement).
# En local : http://localhost:10000
PUBLIC_BASE_URL=
