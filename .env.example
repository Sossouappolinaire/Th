# Copiez ce fichier en .env pour un test en local (ne jamais commiter le .env réel)

# Port d'écoute (Render fournit automatiquement PORT ; 10000 en repli local)
PORT=10000

# Clés API SebPay (tableau de bord SebPay) :
#  - SEBPAY_PUBLIC_KEY : clé publique (pk_live_... ou pk_test_...)
#  - SEBPAY_SECRET_KEY : clé secrète (sk_live_... ou sk_test_...) — sert à
#    signer les requêtes ET à vérifier la signature des webhooks entrants.
#    ⚠️ Ne JAMAIS exposer cette clé côté client / dans un dépôt public.
SEBPAY_BASE_URL=https://newapi.sebpay.bj/api/v1
SEBPAY_PUBLIC_KEY=pk_live_votre_cle_publique
SEBPAY_SECRET_KEY=sk_live_votre_cle_secrete

# URL publique de votre service (utilisée pour construire les callback_url
# envoyées à SebPay pour les webhooks). SUR RENDER, LAISSEZ CETTE LIGNE VIDE
# OU SUPPRIMEZ-LA : Render fournit automatiquement RENDER_EXTERNAL_URL,
# l'app la détecte toute seule. Ne renseignez PUBLIC_BASE_URL que pour
# forcer une valeur différente (autre hébergeur, domaine personnalisé, test
# en local — mais SebPay ne pourra alors pas atteindre vos webhooks tant que
# ce service n'est pas exposé publiquement).
# En local : http://localhost:10000
PUBLIC_BASE_URL=
ADMIN_TOKEN=
