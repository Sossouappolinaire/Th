# Copiez ce fichier en .env pour un test en local (ne jamais commiter le .env réel)

# Port d'écoute (Render fournit automatiquement PORT ; 10000 en repli local)
PORT=10000

# Clés SebPay (dashboard marchand new.sebpay.bj)
SEBPAY_BASE_URL=https://newapi.sebpay.bj/api/v1
SEBPAY_PUBLIC_KEY=pk_live_votre_cle
SEBPAY_SECRET_KEY=sk_live_votre_cle

# URL publique de votre service (utilisée pour construire callback_url).
# En local : http://localhost:10000
# Sur Render : https://votre-service.onrender.com
PUBLIC_BASE_URL=http://localhost:10000
